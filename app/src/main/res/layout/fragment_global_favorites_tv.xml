<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-09-27 : Cœur (favoris globaux) TV, style panneau Radio :
     en-tête + bascule de filtres + carte Reprendre + puces de tri + grille de jaquettes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C0F"
    tools:deviceIds="tv">

    <LinearLayout
        android:id="@+id/ll_fav_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_fav_panel_mobile"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="0dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Favoris"
                android:textColor="#F5F6F8"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_fav_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_badge_mobile"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:textColor="#DDE0E5"
                android:textSize="12sp"
                tools:text="47" />

            <TextView
                android:id="@+id/tv_fav_sources"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_fav_badge_mobile"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:textColor="#DDE0E5"
                android:textSize="12sp"
                tools:text="6 sources" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_fav_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_btn_tv"
                android:focusable="true"
                android:padding="6dp"
                android:text="🗑"
                android:textColor="#9AA0AA"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Filtres + tri sur une ligne (TV : large) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_fav_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_seg_mobile"
                android:orientation="horizontal"
                android:padding="3dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/ll_fav_sorts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="6dp"
                    android:text="Trier :"
                    android:textColor="#9AA0AA"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Carte Reprendre -->
        <LinearLayout
            android:id="@+id/ll_fav_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fav_card_mobile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_resume_poster"
                android:layout_width="30dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_resume_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#F5F6F8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="84 m²" />

                    <TextView
                        android:id="@+id/tv_resume_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_fav_badge_mobile"
                        android:paddingStart="7dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="1dp"
                        android:textColor="#DDE0E5"
                        android:textSize="9sp"
                        tools:text="Movix" />

                    <TextView
                        android:id="@+id/tv_resume_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#9AA0AA"
                        android:textSize="11sp"
                        tools:text="Reprendre · reste 55 min" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_resume"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="240dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="#2F343E"
                    android:progressTint="#E23B3B"
                    tools:progress="52" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_resume_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_btn_tv"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="⏮"
                android:textColor="#DDE0E5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_resume_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_fav_play_tv"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_resume_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fav_btn_tv"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="⏭"
                android:textColor="#DDE0E5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Grille de jaquettes -->
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/vgv_fav"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            app:focusOutFront="true"
            app:numberOfColumns="8" />

        <TextView
            android:id="@+id/tv_fav_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="Aucun favori ni reprise de lecture"
            android:textColor="#9AA0AA"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_fav_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="#E23B3B" />
</FrameLayout>
