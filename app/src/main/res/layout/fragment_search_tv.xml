<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="12dp"
        app:layout_goneMarginEnd="100dp"
        android:background="@drawable/bg_search_edittext"
        app:layout_constraintEnd_toStartOf="@id/mini_player_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mini_player_overlay">

        <androidx.leanback.widget.SearchEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusRight="@+id/btn_search_history"
            android:nextFocusDown="@id/ll_global_search"
            android:padding="14dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_history"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_search_history"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btn_search_clear"
            android:padding="10dp"
            android:src="@drawable/ic_history"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_clear"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btn_search_voice"
            android:padding="10dp"
            android:src="@drawable/ic_search_clear"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_voice"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_global_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:nextFocusDown="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/cl_search">

        <TextView
            android:id="@+id/tv_global_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/global_search"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/iv_global_search_switch"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_switch_off"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- 2026-05-24 : historique de recherche (ajout layout manquant de l'autre session) -->
    <LinearLayout
        android:id="@+id/ll_history_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="100dp"
        android:paddingEnd="100dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_global_search">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recherches récentes"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Effacer"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="100dp"
        android:paddingEnd="100dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_history_header" />

    <!-- 2026-09-22 : mini-lecteur de la recherche TV — copie CONFORME de l'onglet des
         chaines (barre de commandes en haut a gauche, video en encart haut a droite),
         avec les cibles de focus retargetees sur la grille de recherche. La version
         simplifiee posee plus tot masquait la barre de recherche et les jaquettes, et
         n'offrait aucune commande.
         Boutons mini player — barre HORIZONTALE en HAUT À GAUCHE,
         détachée du mini lecteur. Ordre : ⛶ → ⏸ → ✕ -->
    <LinearLayout
        android:id="@+id/mini_player_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="8dp"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="70dp"
        android:layout_marginTop="8dp">

        <!-- Avancement du mini-lecteur TV (voir fragment_home_tv.xml). -->
        <LinearLayout
            android:id="@+id/mini_player_progress_row"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="@drawable/bg_focus_white_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/mini_player_fullscreen">

            <TextView
                android:id="@+id/mini_player_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:text="0:00" />

            <ProgressBar
                android:id="@+id/mini_player_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="4dp"
                android:max="1000"
                android:progressTint="#E50914"
                android:progressBackgroundTint="#66FFFFFF"
                android:focusable="false" />

            <TextView
                android:id="@+id/mini_player_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:text="3:42" />
        </LinearLayout>

    <!-- 2026-08-18 : voir fragment_home_tv.xml — bandeau vertical, rangée de
         boutons inchangée en haut, avancement en dessous. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mini_player_channel_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/mini_player_loading"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:indeterminateTintMode="src_in"
            android:indeterminateTint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_fullscreen"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_mini_player_fullscreen"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/mini_player_prev"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_search"
            android:nextFocusLeft="@id/et_search"
            android:contentDescription="Agrandir" />

        <!-- 2026-08-18 : ⏮ / ⏭ ajoutés dans le bandeau (voir fragment_home_tv.xml). -->
        <ImageView
            android:id="@+id/mini_player_prev"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_fullscreen"
            android:nextFocusRight="@id/mini_player_pause"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_search"
            android:contentDescription="Précédent"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_pause"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_mini_player_pause"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_prev"
            android:nextFocusRight="@id/mini_player_next"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_search"
            android:contentDescription="Pause" />

        <ImageView
            android:id="@+id/mini_player_next"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_pause"
            android:nextFocusRight="@id/mini_player_close"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_search"
            android:contentDescription="Suivant"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_close"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_next"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_search"
            android:contentDescription="Fermer"
            app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Mini Player — vidéo pure, flush top-right. Pas d'overlay dedans. -->
    <FrameLayout
        android:id="@+id/mini_player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#FF000000"
        android:elevation="8dp"
        app:layout_constraintWidth_percent="0.50"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/mini_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:show_buffering="when_playing"
            app:resize_mode="fit" />
    </FrameLayout>

    <!-- Nom de chaîne caché — garde le binding fonctionnel -->
    <TextView
        android:id="@+id/mini_player_channel_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2026-09-22 : la grille doit demarrer sous LE PLUS BAS des deux — l'encart video
         (haut a droite, 16:9 sur la moitie de la largeur) ou le bloc de recherche, bien
         plus court. Sans cette barriere, la premiere rangee de jaquettes passait sous la
         video. Quand l'encart est masque, il ne compte plus et la grille remonte seule. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barriere_haut_grille"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="mini_player_container,rv_history" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barriere_haut_grille"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>