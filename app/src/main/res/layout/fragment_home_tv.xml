<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.home.HomeTvFragment">

    <ImageView
        android:id="@+id/iv_home_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="ContentDescription" />

    <!-- 2026-06-29 RESTAURÉ depuis APK v1.7.226 — Luminosité TV du fond/carrousel.
         View noir à alpha variable au-dessus du iv_home_background.
         Contrôlé par UserPreferences.carouselDim (SeekBar CAROUSEL_DIM, Paramètres TV).
         alpha=0 → fond normal. alpha=1.0 → écran totalement noir.
         Ne capte pas le focus pour ne pas bloquer la navigation D-pad. -->
    <View
        android:id="@+id/view_carousel_dim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_home_background"
        app:layout_constraintEnd_toEndOf="@+id/iv_home_background"
        app:layout_constraintStart_toStartOf="@+id/iv_home_background"
        app:layout_constraintTop_toTopOf="@+id/iv_home_background" />

    <!-- Boutons mini player — barre HORIZONTALE en HAUT À GAUCHE de l'écran,
         détachée du mini lecteur. Ordre : ⛶ Agrandir → ⏸ Pause → ✕ Fermer.
         À côté du bouton quitter provider (sidebar). D-pad focusable. -->
    <LinearLayout
        android:id="@+id/mini_player_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="8dp"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="70dp"
        android:layout_marginTop="8dp">

        <!-- Avancement du mini-lecteur TV : intégré AU MÊME bandeau, donc décalé
             à gauche comme lui. Masqué automatiquement sur un DIRECT (durée
             inconnue).
             2026-08-18 (user : « t'as qu'à mettre la barre au-dessus, peut-être que
             ce sera plus praticable ») : elle est donc placée AU-DESSUS des boutons.
             On y monte avec HAUT depuis n'importe quel bouton (rien au-dessus
             avant, donc aucune touche n'est volée), on en redescend sur ⛶.
             GAUCHE/DROITE y reculent/avancent la lecture de 10 s.
             ⚠ BAS depuis les boutons va TOUJOURS directement à la grille : le
             maniement des jaquettes est inchangé. -->
        <LinearLayout
            android:id="@+id/mini_player_progress_row"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:foreground="@drawable/bg_focus_white_border"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/mini_player_fullscreen">

            <TextView
                android:id="@+id/mini_player_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:text="0:00" />

            <ProgressBar
                android:id="@+id/mini_player_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="4dp"
                android:max="1000"
                android:progressTint="#E50914"
                android:progressBackgroundTint="#66FFFFFF"
                android:focusable="false" />

            <TextView
                android:id="@+id/mini_player_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:text="3:42" />
        </LinearLayout>

    <!-- 2026-08-18 (user : « je voudrais aussi intégrer la barre de progression
         à celle-ci — je parle bien du mini-lecteur télé ») : le bandeau devient
         VERTICAL. En haut, exactement la même rangée de boutons qu'avant (rien
         n'a bougé, même ordre, même focus D-pad) ; en dessous, l'avancement. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mini_player_channel_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/mini_player_loading"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:indeterminateTintMode="src_in"
            android:indeterminateTint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_fullscreen"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_mini_player_fullscreen"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/mini_player_prev"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_home"
            android:nextFocusLeft="@id/home"
            android:contentDescription="Agrandir" />

        <!-- 2026-08-18 (user : « il nous manque peut-être les deux flèches suivant
             et précédent dans la même barre ») : ⏮ et ⏭ encadrent ⏸, comme sur
             mobile. ⛶ reste en premier et ✕ en dernier — l'ordre auquel tu es
             habitué ne bouge pas. -->
        <ImageView
            android:id="@+id/mini_player_prev"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_fullscreen"
            android:nextFocusRight="@id/mini_player_pause"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_home"
            android:contentDescription="Précédent"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_pause"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_mini_player_pause"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_prev"
            android:nextFocusRight="@id/mini_player_next"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_home"
            android:contentDescription="Pause" />

        <ImageView
            android:id="@+id/mini_player_next"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_pause"
            android:nextFocusRight="@id/mini_player_close"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_home"
            android:contentDescription="Suivant"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/mini_player_close"
            android:foreground="@drawable/bg_focus_white_border"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/mini_player_next"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:nextFocusDown="@id/vgv_home"
            android:contentDescription="Fermer"
            app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Mini player = vidéo pure, flush top-right. Pas d'overlay dedans.
         2026-06-24 v3 (user "trop agrandi, réduis") : 0.65 → 0.55 width.
         Ratio 16:9 conservé → height ~31% écran TV (juste un peu plus
         que l'original 0.50 = 28%). Compromis : visible mais ne pousse
         pas la grille trop bas. -->
    <FrameLayout
        android:id="@+id/mini_player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#FF000000"
        android:elevation="8dp"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/mini_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:show_buffering="when_playing"
            app:resize_mode="fit"
            app:surface_type="surface_view" />

        <ImageView
            android:id="@+id/mini_swap_freeze_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- 2026-08-11 (user « comme dans mon IPTV, on a la place sur la gauche quand on a le
         mini lecteur qui s'affiche… pour la version télé » puis « on a qu'à mettre l'EPG que
         sur la version télé ») : guide des programmes.

         L'emplacement existait déjà et n'est occupé par RIEN : le mini lecteur est collé en
         haut à DROITE (55 % de large), et updateHomeGridForMiniPlayer() repousse toute la
         grille SOUS lui. La bande haut-gauche était donc vide. Aucun réagencement, on
         remplit un trou (user : « sinon on t'ajoute seulement le menu EPG, pas besoin de
         tout refaire »).

         Non focusable de bout en bout : la navigation D-pad ne doit pas changer d'un poil.
         Données : EpgStore (rapprochement par NOM de chaîne, indépendant du provider). -->
    <LinearLayout
        android:id="@+id/ll_epg_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="8dp"
        android:clickable="false"
        android:focusable="false"
        android:gravity="bottom"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mini_player_container"
        app:layout_constraintTop_toBottomOf="@+id/mini_player_overlay"
        app:layout_constraintBottom_toBottomOf="@+id/mini_player_container">

        <TextView
            android:id="@+id/tv_epg_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="TF1" />

        <TextView
            android:id="@+id/tv_epg_now_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/epg_en_ce_moment"
            android:textColor="#8AB4F8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_epg_now_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            tools:text="Journal de 20h" />

        <TextView
            android:id="@+id/tv_epg_now_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            tools:text="20:00 – 20:45 · reste 12 min" />

        <ProgressBar
            android:id="@+id/pb_epg_now"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressTint="#8AB4F8"
            android:progressBackgroundTint="#40FFFFFF" />

        <TextView
            android:id="@+id/tv_epg_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/epg_a_suivre"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_epg_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            tools:text="21:10  Koh-Lanta" />
    </LinearLayout>

    <!-- Nom de chaîne caché — garde le binding fonctionnel -->
    <TextView
        android:id="@+id/mini_player_channel_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:nextFocusDown="@id/iv_iptv_categories"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="1"
        tools:listitem="@layout/content_category_swiper_tv" />

    <!-- 2026-05-13 (user "il faut que tu fasses la même chose pour la TV
         maintenant le même procédé ça serait vraiment cool avec les mêmes
         boutons mais peut-être pas au même endroit") : 2 boutons IPTV top-left
         (catégories + filtre langue) — visibles seulement pour Mon IPTV. Le
         mini-player occupe top-right donc on les met top-left pour pas
         overlapper. Focusable pour D-pad. -->
    <!-- 2026-05-13 (user "non dans la bar de gauche y a la place") : icônes
         placées verticalement dans la colonne gauche, sous les items du
         sidebar nav_main (search/home/films/séries/favoris/settings) — alignées
         pour avoir l'air d'icônes sidebar supplémentaires. -->
    <LinearLayout
        android:id="@+id/ll_iptv_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 2026-05-13 (user "ce serait plus simple de faire haut pour sortir et
             passer par les boutons pour retourner dans la barre") :
             - DPAD_LEFT depuis iv_iptv_categories → sidebar (nav_main item home)
             - DPAD_UP depuis vgv_home → revient sur ces boutons (déjà câblé)
             - DPAD_RIGHT entre catégories ↔ langue (déjà câblé) -->
        <ImageView
            android:id="@+id/iv_iptv_categories"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_categories_filter"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@id/home"
            android:nextFocusRight="@id/vgv_home"
            android:nextFocusDown="@id/iv_iptv_language"
            android:nextFocusUp="@id/mini_player_progress_row"
            android:contentDescription="Catégories IPTV"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/iv_iptv_language"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_iptv_language"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@id/home"
            android:nextFocusRight="@id/vgv_home"
            android:nextFocusUp="@id/iv_iptv_categories"
            android:nextFocusDown="@id/iv_vavoo_tunnel"
            android:contentDescription="Filtre langue IPTV"
            app:tint="@android:color/white" />

        <!-- 2026-06-17 (user "il faut faire un bouton de bascule, de base il est
             pas activé et on l'active") : bouton tunnel Vavoo via serveurs free
             VYPN, visible UNIQUEMENT sur Vavoo TV. OFF par défaut. -->
        <ImageView
            android:id="@+id/iv_vavoo_tunnel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_vavoo_tunnel"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@id/home"
            android:nextFocusRight="@id/vgv_home"
            android:nextFocusUp="@id/iv_iptv_language"
            android:contentDescription="Mode tunnel Vavoo (France)"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </LinearLayout>

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
